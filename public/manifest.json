{
  "manifest_version": 3,
  "name": "BiliCueNote · B站视频摘要与字幕问答",
  "version": "0.1.0",
  "description": "B 站视频摘要：带时间戳的摘要、完整字幕与对话。使用你自己的 OpenAI 兼容 API Key。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": ["https://www.bilibili.com/*", "https://*.hdslb.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BiliCueNote · B站视频摘要与字幕问答",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
